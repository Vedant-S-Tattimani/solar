{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ktech-solar",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // serve /site/*.html exactly as named (the Next rewrites point at these files)
    "html_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
